const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const t=e.target;t.classList.add('in');io.unobserve(t);const b=t.querySelector('[data-v]');if(b){const v=+b.dataset.v,s=b.dataset.s,t0=performance.now(),f=n=>{const p=Math.min((n-t0)/1300,1);b.textContent=Math.round(v*(1-Math.pow(1-p,3)))+s;if(p<1)requestAnimationFrame(f)};requestAnimationFrame(f)}}),{threshold:.2});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
